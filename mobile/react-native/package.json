{
  "name": "motion-mobile",
  "version": "1.0.0",
  "description": "Motion Transport - React Native Mobile App",
  "main": "index.ts",
  "scripts": {
    "dev": "npx --yes -p node@20 -p expo@50.0.21 expo start --lan",
    "dev:ios": "npx --yes -p node@20 -p expo@50.0.21 expo start --ios",
    "dev:android": "npx --yes -p node@20 -p expo@50.0.21 expo start --android",
    "dev:web": "npx --yes -p node@20 -p expo@50.0.21 expo start --web",
    "build": "npm run type-check && cross-env NODE_PATH=./node_modules npx --yes -p node@20 -p expo@50.0.21 expo export --platform all",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-masked-view/masked-view": "0.3.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "expo": "^50.0.0",
    "expo-constants": "^15.0.0",
    "expo-location": "^16.0.0",
    "expo-secure-store": "^12.0.0",
    "expo-sensors": "~12.9.0",
    "expo-status-bar": "~1.11.1",
    "react": "^18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-paper": "^5.10.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-toast-message": "^2.1.5",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "~18.2.45",
    "cross-env": "^7.0.3",
    "eslint": "^8.50.0",
    "expo-dev-client": "~3.3.12",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18 <21"
  }
}
