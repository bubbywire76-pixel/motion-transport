# Motion Transport Mobile App - Environment Configuration

# Public app configuration; never put service secrets in this file.
# Android emulator: http://10.0.2.2:5000/api
# iOS simulator: http://localhost:5000/api
# Physical phone: replace with your computer's LAN address, e.g.
# http://192.168.1.25:5000/api (phone and computer must share a network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_RELEASE_CHANNEL=development

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
